diff --git a/third_party/blink/web_tests/http/tests/inspector-protocol/fetch/offgrid-metadata-only.js b/third_party/blink/web_tests/http/tests/inspector-protocol/fetch/offgrid-metadata-only.js
new file mode 100644
--- /dev/null
+++ b/third_party/blink/web_tests/http/tests/inspector-protocol/fetch/offgrid-metadata-only.js
@@ -0,0 +1,121 @@
+(async function(testRunner) {
+  const {session, dp} = await testRunner.startBlank(
+      'OffGrid opt-in metadata-only Fetch preserves native upload semantics');
+  const endpoint = testRunner.url('./resources/offgrid-metadata-echo.py');
+  const patterns = [{urlPattern: '*offgrid-metadata-echo.py*'}];
+  const legacyHash = '53d78b316bb8272d761c0011d62a258618d2a374ee727b786a64671ba58726b3';
+  const fileHash = 'dff28c51e4c67e6197520d68f9a7aa73f4d47b1faf1b21afebc6a50765f396cb';
+  const replacementHash = '95713e9cbdd1dfcb2d4080c2537f418d43ca0da25f0d7d6631f4f7c97b89dc47';
+  function check(value, message) {
+    if (!value) throw new Error(message);
+  }
+  async function enable(options = {}) {
+    const result = await dp.Fetch.enable({patterns, ...options});
+    check(!result.error, JSON.stringify(result.error));
+  }
+  function metadata(event, hasBody = true) {
+    check(event.request.hasPostData === hasBody, 'native body presence');
+    check(event.request.postData === undefined, 'postData must be omitted');
+    check(event.request.postDataEntries === undefined, 'entries must be omitted');
+  }
+  function receipt(result, bytes, sha256) {
+    check(result.bytes === bytes && result.sha256 === sha256,
+          'independent receiver digest/size differs: ' + JSON.stringify(result));
+  }
+  async function begin(body, query = '', method = 'POST') {
+    const paused = dp.Fetch.onceRequestPaused();
+    const response = session.evaluateAsync(`
+      window.offgridAbort = new AbortController();
+      fetch(${JSON.stringify(endpoint)} + ${JSON.stringify(query)}, {
+        method: ${JSON.stringify(method)}, body: ${body},
+        signal: window.offgridAbort.signal
+      }).then(r => r.json(), e => ({error: e.name}))`);
+    return {event: (await paused).params, response};
+  }
+  async function proceed(event) {
+    const result = await dp.Fetch.continueRequest({requestId: event.requestId});
+    check(!result.error, 'continue failed: ' + JSON.stringify(result.error));
+  }
+
+  await dp.Network.enable();
+  for (const options of [{}, {includePostData: true}]) {
+    await enable(options);
+    const {event, response} = await begin(`'legacy-body'`);
+    check(event.request.postData === 'legacy-body', 'default body collection changed');
+    check(event.request.postDataEntries.length > 0, 'default entries missing');
+    await proceed(event);
+    receipt(await response, 11, legacyHash);
+  }
+  testRunner.log('PASS omitted and explicit true retain legacy collection');
+
+  await enable({includePostData: false});
+  for (const body of [
+    `new Uint8Array(131072).fill(81)`,
+    `new Blob([new Uint8Array(131072).fill(81)])`,
+    `new File([new Uint8Array(131072).fill(81)], 'fixture.bin')`,
+  ]) {
+    const {event, response} = await begin(body);
+    metadata(event);
+    await proceed(event);
+    receipt(await response, 131072, fileHash);
+  }
+  testRunner.log('PASS byte, Blob and File bodies arrive unchanged without diagnostic bytes');
+
+  {
+    const {event, response} = await begin('undefined', '', 'GET');
+    metadata(event, false);
+    await proceed(event);
+    receipt(await response, 0, 'e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855');
+  }
+  testRunner.log('PASS absent body remains distinguishable');
+  {
+    const {event, response} = await begin(`'legacy-body'`);
+    metadata(event);
+    const result = await dp.Fetch.continueRequest({requestId: event.requestId, postData: btoa('replacement')});
+    check(!result.error, 'explicit body override rejected');
+    receipt(await response, 11, replacementHash);
+  }
+  testRunner.log('PASS explicit continue body override remains supported');
+
+  {
+    const {event, response} = await begin(`new Blob(['legacy-body'])`);
+    metadata(event);
+    const result = await dp.Fetch.failRequest({requestId: event.requestId, errorReason: 'BlockedByClient'});
+    check(!result.error && (await response).error === 'TypeError', 'abort did not reject fetch');
+  }
+  testRunner.log('PASS failRequest rejects the paused native upload');
+  {
+    const {event, response} = await begin(`new Blob(['legacy-body'])`);
+    metadata(event);
+    await session.evaluate('window.offgridAbort.abort()');
+    check((await response).error === 'AbortError', 'page cancellation did not settle');
+  }
+  testRunner.log('PASS page cancellation settles a paused upload');
+
+  {
+    const {event, response} = await begin(`new Blob(['legacy-body'])`, '?redirect=1');
+    metadata(event);
+    await enable({includePostData: true});
+    const redirected = dp.Fetch.onceRequestPaused();
+    await proceed(event);
+    const next = (await redirected).params;
+    metadata(next);
+    check(next.request.method === 'POST', '307 did not preserve method');
+    await proceed(next);
+    receipt(await response, 11, legacyHash);
+  }
+  testRunner.log('PASS existing request retains metadata-only setting through 307');
+
+  await enable({includePostData: false, patterns: [{urlPattern: '*offgrid-metadata-echo.py*', requestStage: 'Response'}]});
+  {
+    const {event, response} = await begin(`new Blob(['legacy-body'])`);
+    metadata(event);
+    check(event.responseStatusCode === 200, 'not a response-stage pause');
+    const result = await dp.Fetch.continueResponse({requestId: event.requestId});
+    check(!result.error, 'response continuation failed');
+    receipt(await response, 11, legacyHash);
+  }
+  testRunner.log('PASS response-stage metadata preserves native receipt');
+  await dp.Fetch.disable();
+  testRunner.completeTest();
+})
