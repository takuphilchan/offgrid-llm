diff --git a/third_party/blink/web_tests/http/tests/inspector-protocol/fetch/resources/offgrid-metadata-echo.py b/third_party/blink/web_tests/http/tests/inspector-protocol/fetch/resources/offgrid-metadata-echo.py
new file mode 100755
--- /dev/null
+++ b/third_party/blink/web_tests/http/tests/inspector-protocol/fetch/resources/offgrid-metadata-echo.py
@@ -0,0 +1,27 @@
+#!/usr/bin/env python3
+"""Disposable Chromium HTTP fixture; no filesystem writes or outbound requests."""
+import hashlib
+import json
+import os
+import sys
+
+length = int(os.environ.get('CONTENT_LENGTH') or '0')
+if length < 0 or length > 8 * 1024 * 1024:
+    sys.stdout.write('Status: 413 Payload Too Large\r\nContent-Length: 0\r\n\r\n')
+else:
+    digest = hashlib.sha256()
+    remaining = length
+    while remaining:
+        chunk = sys.stdin.buffer.read(min(65536, remaining))
+        if not chunk:
+            raise RuntimeError('incomplete request body')
+        digest.update(chunk)
+        remaining -= len(chunk)
+    if os.environ.get('QUERY_STRING') == 'redirect=1':
+        sys.stdout.write('Status: 307 Temporary Redirect\r\n'
+                         'Location: offgrid-metadata-echo.py\r\n'
+                         'Content-Length: 0\r\n\r\n')
+    else:
+        body = json.dumps({'bytes': length, 'sha256': digest.hexdigest()})
+        sys.stdout.write('Content-Type: application/json\r\n'
+                         'Cache-Control: no-store\r\n\r\n' + body)
