# Line endings
* text=auto
*.sh text eol=lf
*.bash text eol=lf
*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
runtimes/llama-cpp/*.h text eol=lf

# Docker files
Dockerfile text eol=lf
docker-compose*.yml text eol=lf

# Documentation
*.md text eol=lf

# Go files
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
internal/server/testdata/*.golden text eol=lf
# Preserve exact fixture/receipt bytes used by the document corpus digest gates.
internal/rag/testdata/documents/corpus/** -text -whitespace
internal/rag/testdata/documents/ocr/inputs/** -text -whitespace
internal/rag/testdata/documents/ocr/*.hocr -text -whitespace
internal/rag/testdata/documents/ocr/native/*.hocr -text -whitespace
internal/rag/testdata/documents/**/*.pdf -diff

# Binary files
*.gguf binary
*.bin binary
*.so binary
*.dll binary
*.dylib binary
*.exe binary

# Linguist overrides for GitHub language statistics
# The desktop host's static entry point is generated by its packaging flow.
apps/desktop/index.html linguist-generated
apps/desktop/node_modules/** linguist-vendored
