# Line endings
* text=auto
*.sh text eol=lf
*.bash text eol=lf

# Docker files
Dockerfile text eol=lf
docker-compose*.yml text eol=lf

# Documentation
*.md text eol=lf

# Go files
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
internal/server/testdata/*.golden text eol=lf

# Binary files
*.gguf binary
*.bin binary
*.so binary
*.dll binary
*.dylib binary
*.exe binary

# Linguist overrides for GitHub language statistics
# The desktop host's static entry point is generated by its packaging flow.
apps/desktop/index.html linguist-generated
apps/desktop/node_modules/** linguist-vendored
