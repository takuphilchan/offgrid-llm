{
  "name": "@offgrid/ui",
  "private": true,
  "version": "0.4.30",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:generate": "openapi-typescript ../../pkg/api/openapi.yaml -o src/api/schema.generated.ts",
    "api:check": "openapi-typescript ../../pkg/api/openapi.yaml -o src/api/schema.generated.ts --check",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit --pretty false",
    "i18n:check": "node ../../scripts/quality/check-translations.mjs",
    "i18n:audit": "node ../../scripts/quality/translation-review.mjs audit",
    "i18n:complete": "node ../../scripts/quality/translation-review.mjs complete",
    "i18n:consistency": "node ../../scripts/quality/translation-consistency.mjs",
    "i18n:rendered": "node ../../scripts/quality/run-rendered-audit.mjs",
    "i18n:rendered:report": "node ../../scripts/quality/run-rendered-audit.mjs --report-only",
    "i18n:ready": "node ../../scripts/quality/translation-review.mjs ready",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "decode-named-character-reference": "1.3.0",
    "hast-util-to-jsx-runtime": "2.3.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0",
    "vite": "^8.1.0"
  }
}
