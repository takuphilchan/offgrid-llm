{
  "name": "@offgrid/ui",
  "private": true,
  "version": "0.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api:generate": "openapi-typescript ../../pkg/api/openapi.yaml -o src/api/schema.generated.ts",
    "api:check": "openapi-typescript ../../pkg/api/openapi.yaml -o src/api/schema.generated.ts --check",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit --pretty false",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "latest",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0",
    "vite": "^8.1.0"
  }
}
