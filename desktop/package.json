{
  "name": "offgrid-llm-desktop",
  "desktopName": "com.offgrid.llm.desktop",
  "version": "0.4.11",
  "description": "OffGrid LLM Desktop - Local AI Platform",
  "homepage": "https://github.com/takuphilchan/offgrid-llm",
  "author": {
    "name": "OffGrid LLM Team",
    "email": "team@offgrid-llm.dev"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "icons": "node ../dev/scripts/generate-icons.mjs",
    "installer:branding": "node ../dev/scripts/generate-installer-branding.mjs",
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:linux": "electron-builder --linux --x64",
    "build:mac": "electron-builder --mac --x64 --arm64",
    "build:win": "electron-builder --win --x64",
    "build:all": "electron-builder -mwl",
    "dist": "electron-builder",
    "package": "npm run build:all"
  },
  "build": {
    "appId": "com.offgrid.llm.desktop",
    "productName": "OffGrid LLM Desktop",
    "copyright": "Copyright © 2024-2026 OffGrid LLM Team",
    "beforePack": "./prepare-computer.cjs",
    "afterPack": "./verify-computer.cjs",
    "protocols": [{ "name": "Open OffGrid tasks", "schemes": ["offgrid"] }],
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "main.js",
      "backend.js",
      "runtime.js",
      "computer-runtime.js",
      "application-launcher.js",
      { "from": "../computer", "to": "computer-pack", "filter": ["pack.cjs"] },
      "presentation.js",
      "preload.js",
      "loading.html",
      "startup.css",
      "startup.js",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/computer-runtime/${os}-${arch}",
        "to": "computer"
      },
      {
        "from": "../build/computer-runtime/${os}-${arch}/node_modules",
        "to": "computer/node_modules"
      },
      {
        "from": "../web/dist",
        "to": "ui",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      }
    ],
    "linux": {
      "extraResources": [
        {
          "from": "../build/linux/offgrid",
          "to": "bin/offgrid",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "icon": "assets/icon.png",
      "maintainer": "OffGrid LLM Team <team@offgrid-llm.dev>",
      "desktop": {
        "entry": {
          "Name": "OffGrid LLM Desktop",
          "GenericName": "Private Local AI Workspace",
          "Comment": "Run private AI models locally",
          "Categories": "Development;Science;Education;",
          "Keywords": "ai;llm;local;private;offline;",
          "Terminal": false,
          "Type": "Application",
          "StartupWMClass": "com.offgrid.llm.desktop"
        }
      },
      "executableName": "offgrid-llm-desktop",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "mac": {
      "signIgnore": ["/Contents/Resources/computer/browsers/"],
      "extraResources": [
        {
          "from": "../build/macos/offgrid-amd64",
          "to": "bin/offgrid-amd64",
          "filter": [
            "**/*"
          ]
        },
        {
          "from": "../build/macos/offgrid-arm64",
          "to": "bin/offgrid-arm64",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libuuid1", "libsecret-1-0", "libjson-glib-1.0-0"]
    },
    "dmg": {
      "title": "OffGrid LLM Desktop ${version}",
      "writeUpdateInfo": false,
      "sign": false,
      "backgroundColor": "#ffffff",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 180
        },
        {
          "x": 410,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "signExts": ["!chrome.exe", "!chrome_proxy.exe", "!chrome_pwa_launcher.exe", "!elevated_tracing_service.exe", "!elevation_service.exe", "!notification_helper.exe", "!setup.exe", "!ffmpeg-win64.exe", "!PrintDeps.exe"],
      "extraResources": [
        {
          "from": "../build/windows/offgrid.exe",
          "to": "bin/offgrid.exe",
          "filter": [
            "**/*"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OffGrid LLM Desktop",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "include": "assets/installer.nsh",
      "installerHeader": "assets/installer-header.bmp",
      "installerSidebar": "assets/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/installer-sidebar.bmp",
      "warningsAsErrors": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  }
}
