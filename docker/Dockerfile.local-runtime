# Local application/UI refresh only. Not used by release CI.
# Reuse a locally verified, unchanged runtime while building the application
# separately with docker/Dockerfile --target application-artifacts. Supply both
# image references explicitly. This does not qualify a new native runtime or
# replace the full CPU/GPU build checks required for a release.
ARG APPLICATION_IMAGE=offgrid-llm:local-application
ARG RUNTIME_IMAGE=offgrid-llm:local-runtime
FROM ${APPLICATION_IMAGE} AS application
FROM node:22-alpine AS checked-ui
COPY --from=application /var/lib/offgrid/web/ui /ui
COPY desktop/compatibility.cjs /compatibility.cjs
RUN node -e "require('/compatibility.cjs').verifyUI('/ui')"
FROM ${RUNTIME_IMAGE}

ARG RUNTIME_IMAGE
ARG VERSION=dev
ARG VCS_REF=unknown

LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.offgrid.build-kind="local-runtime-reuse" \
      org.offgrid.runtime-image="${RUNTIME_IMAGE}"

# The application is a static Go binary. Preserve the base runtime's user,
# CUDA libraries, llama-server, healthcheck, permissions and startup settings.
COPY --from=application --chmod=0755 /usr/local/bin/offgrid /usr/local/bin/offgrid
COPY --from=checked-ui --chown=1000:1000 /ui /var/lib/offgrid/web/ui
# Reused speech runtimes may point at /usr/local/share/offgrid/ui. Always select
# the matching renderer copied above; operators must also update any container
# environment override when recreating a previously deployed container.
ENV OFFGRID_VERSION=${VERSION} \
    OFFGRID_UI_DIR=/var/lib/offgrid/web/ui
